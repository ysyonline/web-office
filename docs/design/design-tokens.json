  "A2_semantic": {
    "color": {
      "bg":      { "value": "{A1_primitive.color.neutral.50}",  "type": "color" },
      "surface": { "value": "{A1_primitive.color.neutral.0}",   "type": "color" },
      "fg":      { "value": "{A1_primitive.color.neutral.900}", "type": "color" },
      "muted":   { "value": "{A1_primitive.color.neutral.500}", "type": "color" },
      "border":  { "value": "{A1_primitive.color.neutral.200}", "type": "color" },
      "accent":        { "value": "{A1_primitive.color.emerald.600}", "type": "color" },
      "accentOn":      { "value": "#FFFFFF", "type": "color" },
      "accentHover":   { "value": "{A1_primitive.color.emerald.700}", "type": "color" },
      "accentActive":  { "value": "{A1_primitive.color.emerald.800}", "type": "color" },
      "accentSubtle":  { "value": "{A1_primitive.color.emerald.50}",  "type": "color", "comment": "浅底选中态/标签底" },
      "accentSubtleHover": { "value": "{A1_primitive.color.emerald.100}", "type": "color" },
      "success": { "value": "{A1_primitive.color.green.600}",  "type": "color" },
      "successBg": { "value": "{A1_primitive.color.green.50}", "type": "color" },
      "warn":    { "value": "{A1_primitive.color.amber.600}",  "type": "color" },
      "warnBg":  { "value": "{A1_primitive.color.amber.50}",   "type": "color" },
      "danger":  { "value": "{A1_primitive.color.red.600}",    "type": "color" },
      "dangerBg": { "value": "{A1_primitive.color.red.50}",    "type": "color" },
      "info":    { "value": "{A1_primitive.color.blue.600}",   "type": "color" },
      "infoBg":  { "value": "{A1_primitive.color.blue.50}",    "type": "color" }
    },
    "fontSize": {
      "xs":   { "value": "0.75rem",   "px": 12, "type": "dimension", "comment": "行列头/辅助文字/徽章" },
      "sm":   { "value": "0.8125rem", "px": 13, "type": "dimension", "comment": "正文/单元格默认字号" },
      "base": { "value": "0.875rem",  "px": 14, "type": "dimension", "comment": "表单/按钮/列表正文" },
      "lg":   { "value": "1rem",      "px": 16, "type": "dimension", "comment": "页面标题/对话框标题" },
      "xl":   { "value": "1.25rem",   "px": 20, "type": "dimension", "comment": "登录页主标题" }
    },
    "fontWeight": {
      "regular":  { "value": 400, "type": "fontWeight", "comment": "正文/说明" },
      "medium":   { "value": 510, "type": "fontWeight", "comment": "按钮/表头/小标题" },
      "semibold": { "value": 590, "type": "fontWeight", "comment": "页面标题/对话框标题" }
    },
    "lineHeight": {
      "tight": { "value": 1.25, "type": "number" },
      "body":  { "value": 1.5,  "type": "number" },
      "cell":  { "value": 1.4,  "type": "number" }
    },
    "space": {
      "0":  { "value": "0",     "type": "dimension" },
      "1":  { "value": "4px",   "type": "dimension" },
      "2":  { "value": "8px",   "type": "dimension" },
      "3":  { "value": "12px",  "type": "dimension" },
      "4":  { "value": "16px",  "type": "dimension" },
      "5":  { "value": "20px",  "type": "dimension" },
      "6":  { "value": "24px",  "type": "dimension" },
      "8":  { "value": "32px",  "type": "dimension" },
      "10": { "value": "40px",  "type": "dimension" },
      "12": { "value": "48px",  "type": "dimension" }
    },
    "radius": {
      "sm":   { "value": "4px",    "type": "dimension", "comment": "徽章/标签" },
      "md":   { "value": "6px",    "type": "dimension", "comment": "按钮/输入框/工具栏按钮" },
      "lg":   { "value": "8px",    "type": "dimension", "comment": "卡片/对话框" },
      "pill": { "value": "9999px", "type": "dimension", "comment": "头像/状态点" }
    },
    "shadow": {
      "none":   { "value": "none", "type": "boxShadow" },
      "xs":     { "value": "0 1px 2px rgba(17, 24, 39, 0.05)", "type": "boxShadow" },
      "raised": { "value": "0 1px 2px rgba(17,24,39,0.04), 0 4px 8px rgba(17,24,39,0.06)", "type": "boxShadow", "comment": "下拉菜单/右键菜单/对话框" },
      "overlay": { "value": "0 8px 24px rgba(17, 24, 39, 0.12)", "type": "boxShadow", "comment": "模态遮罩层上的对话框" }
    },
    "motion": {
      "fast":   { "value": "150ms", "type": "duration", "comment": "hover/选中态收敛值" },
      "base":   { "value": "200ms", "type": "duration", "comment": "下拉展开/toast" },
      "slow":   { "value": "300ms", "type": "duration", "comment": "对话框进入" },
      "easing": { "value": "cubic-bezier(0.2, 0, 0, 1)", "type": "cubicBezier" }
    },
    "focusRing": { "value": "0 0 0 2px {A1_primitive.color.neutral.0}, 0 0 0 4px rgba(5, 150, 105, 0.35)", "type": "boxShadow" }
  },

  "B_slot_component": {
    "button": {
      "primary": {
        "bg": "{A2_semantic.color.accent}", "text": "{A2_semantic.color.accentOn}",
        "bgHover": "{A2_semantic.color.accentHover}", "bgActive": "{A2_semantic.color.accentActive}",
        "disabledBg": "{A1_primitive.color.neutral.100}", "disabledText": "{A1_primitive.color.neutral.400}",
        "radius": "{A2_semantic.radius.md}", "height": "32px", "paddingX": "{A2_semantic.space.3}", "fontSize": "{A2_semantic.fontSize.base}", "fontWeight": "{A2_semantic.fontWeight.medium}"
      },
      "secondary": {
        "bg": "{A2_semantic.color.surface}", "text": "{A1_primitive.color.neutral.700}", "border": "{A2_semantic.color.border}",
        "bgHover": "{A1_primitive.color.neutral.50}", "radius": "{A2_semantic.radius.md}", "height": "32px"
      },
      "ghost": {
        "bg": "transparent", "text": "{A1_primitive.color.neutral.700}",
        "bgHover": "{A1_primitive.color.neutral.100}", "radius": "{A2_semantic.radius.md}", "height": "32px"
      },
      "danger": {
        "bg": "{A2_semantic.color.danger}", "text": "#FFFFFF", "bgHover": "{A1_primitive.color.red.700}", "radius": "{A2_semantic.radius.md}", "height": "32px"
      }
    },
    "toolbarButton": {
      "comment": "表格编辑器工具栏内图标按钮",
      "size": "28px", "iconSize": "16px", "radius": "{A2_semantic.radius.sm}",
      "bg": "transparent", "bgHover": "{A1_primitive.color.neutral.100}", "bgActive": "{A1_primitive.color.neutral.200}",
      "bgToggled": "{A2_semantic.color.accentSubtle}", "textToggled": "{A2_semantic.color.accent}",
      "disabledText": "{A1_primitive.color.neutral.300}"
    },
    "input": {
      "bg": "{A2_semantic.color.surface}", "border": "{A1_primitive.color.neutral.300}", "text": "{A2_semantic.color.fg}",
      "placeholder": "{A1_primitive.color.neutral.400}",
      "borderHover": "{A1_primitive.color.neutral.400}",
      "focusRing": "{A2_semantic.focusRing}",
      "errorBorder": "{A2_semantic.color.danger}",
      "disabledBg": "{A1_primitive.color.neutral.100}", "disabledText": "{A1_primitive.color.neutral.400}",
      "radius": "{A2_semantic.radius.md}", "height": "32px", "paddingX": "{A2_semantic.space.3}", "fontSize": "{A2_semantic.fontSize.base}"
    },
    "dropdown": {
      "bg": "{A2_semantic.color.surface}", "border": "{A2_semantic.color.border}", "shadow": "{A2_semantic.shadow.raised}",
      "radius": "{A2_semantic.radius.lg}", "itemHeight": "32px", "itemPaddingX": "{A2_semantic.space.3}",
      "itemHoverBg": "{A1_primitive.color.neutral.100}", "itemSelectedBg": "{A2_semantic.color.accentSubtle}", "itemSelectedText": "{A2_semantic.color.accent}"
    },
    "contextMenu": {
      "inherits": "dropdown", "minWidth": "180px",
      "dangerItemText": "{A2_semantic.color.danger}", "dangerItemHoverBg": "{A2_semantic.color.dangerBg}"
    },
    "dialog": {
      "bg": "{A2_semantic.color.surface}", "radius": "{A2_semantic.radius.lg}", "shadow": "{A2_semantic.shadow.overlay}",
      "overlay": "rgba(17, 24, 39, 0.4)", "width": "480px", "padding": "{A2_semantic.space.6}",
      "titleFontSize": "{A2_semantic.fontSize.lg}", "titleFontWeight": "{A2_semantic.fontWeight.semibold}"
    },
    "toast": {
      "bg": "{A1_primitive.color.neutral.900}", "text": "#FFFFFF", "radius": "{A2_semantic.radius.md}",
      "padding": "8px 12px", "fontSize": "{A2_semantic.fontSize.sm}", "duration": "3000ms",
      "variantBorder": { "success": "{A2_semantic.color.success}", "warn": "{A2_semantic.color.warn}", "error": "{A2_semantic.color.danger}" }
    },
    "table": {
      "headerBg": "{A1_primitive.color.neutral.150}", "headerText": "{A1_primitive.color.neutral.600}",
      "rowBorder": "{A1_primitive.color.neutral.200}", "rowHoverBg": "{A1_primitive.color.neutral.50}",
      "cellPadding": "0 12px", "rowHeight": "40px"
    }
  },

