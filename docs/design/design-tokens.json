      "selectionFill":   { "value": "rgba(5, 150, 105, 0.06)", "type": "color" },
      "fillHandle":      { "value": "{A2_semantic.color.accent}", "type": "color", "comment": "右下角填充柄 6×6 方块" },
      "resizeGuide":     { "value": "{A2_semantic.color.accent}", "type": "color", "comment": "行列拖拽调宽 1px 参考线" }
    },
    "sheetTab": {
      "text":            { "value": "{A1_primitive.color.neutral.600}", "type": "color" },
      "hoverBg":         { "value": "{A1_primitive.color.neutral.100}", "type": "color" },
