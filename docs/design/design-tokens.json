      "savingColor": { "value": "{A2_semantic.color.muted}", "type": "color" },
      "offlineColor": { "value": "{A2_semantic.color.warn}", "type": "color" }
    },
    "readonlyBanner": {
      "comment": "License 缺失/过期/超席只读提示条（挂应用布局根、标题栏栈之外）",
      "height": { "value": "32px", "type": "dimension" },
      "bg": { "value": "{A2_semantic.color.warnBg}", "type": "color" },
      "border": { "value": "{A2_semantic.color.warn}", "type": "color", "comment": "仅 1px 下边框，非左边框" },
      "text": { "value": "{A1_primitive.color.amber.700}", "type": "color" }
    }
  },

  "layout": {
    "titleBar":    { "value": "44px", "type": "dimension" },
    "toolbar":     { "value": "40px", "type": "dimension" },
    "formulaBar":  { "value": "32px", "type": "dimension" },
    "headerTotal": { "value": "116px", "type": "dimension", "comment": "44+40+32，硬上限 120px" },
    "rowHeaderHeight":   { "value": "24px", "type": "dimension" },
    "columnHeaderWidth": { "value": "64px", "type": "dimension" },
    "sheetBar":    { "value": "36px", "type": "dimension" },
    "statusBar":   { "value": "28px", "type": "dimension" },
    "sidebarAdmin": { "value": "200px", "type": "dimension", "comment": "管理后台左侧导航" },
    "containerMax": { "value": "1200px", "type": "dimension" }
  },

  "zIndex": {
    "base":        { "value": 0,    "type": "number" },
    "grid":        { "value": 10,   "type": "number" },
    "gridHeader":  { "value": 20,   "type": "number" },
    "sticky":      { "value": 1100, "type": "number", "comment": "标题栏/工具栏吸顶" },
    "dropdown":    { "value": 1200, "type": "number" },
    "contextMenu": { "value": 1250, "type": "number" },
    "modal":       { "value": 1300, "type": "number" },
    "toast":       { "value": 1400, "type": "number" },
    "tooltip":     { "value": 1500, "type": "number" }
  }
}
