{
  "name": "@wo/server",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "NestJS 11 服务端（CJS + 装饰器）。P3-010-03 落入口骨架；P3-011-01 落运行期依赖与测试装配；引导/模块划分/国密启动断言链由 P3-011-02 起接管。",
  "scripts": {
    "build": "tsc -p ../../packages/shared/tsconfig.build.esm.json && tsc -p ../../packages/shared/tsconfig.build.cjs.json && node ../../packages/shared/scripts/postbuild.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@wo/shared": "workspace:*",
    "lib0": "0.2.119",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/ws": "8.18.2",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
