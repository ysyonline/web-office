{
  "name": "web-office",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/shared/tsconfig.json",
    "build": "tsc -p packages/shared/tsconfig.build.esm.json && tsc -p packages/shared/tsconfig.build.cjs.json && node packages/shared/scripts/postbuild.mjs",
    "test:rules": "node --test packages/config/rules/no-emoji.test.ts packages/config/rules/no-hardcoded-color.test.ts",
    "check:deps": "node scripts/check-workspace-deps.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sm-crypto": "0.5.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
